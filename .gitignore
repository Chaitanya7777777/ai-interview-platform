# ── Secrets — NEVER commit these ──────────────────────────────────────────────
**/.env
**/.env.local
**/.env.production
**/.env.*.local
# Keep .env.example files (they are templates, no real secrets)
!**/.env.example

# ── Frontend ───────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/next-env.d.ts

# ── Backend ────────────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/dist/
backend/build/

# ── Python ────────────────────────────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Root venv ─────────────────────────────────────────────────────────────────
.venv/
venv/