# Production example environment variables for the FastAPI backend
# Copy this file to `.env` and fill in real secrets. DO NOT commit `.env` to source control.

# PostgreSQL connection string using asyncpg for SQLAlchemy
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://db_user:db_password@db-host.example.com:5432/resume_analyser_db

# Supabase project URL (base API URL)
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase anon public key (for client-side usage). Keep service role key secret.
SUPABASE_ANON_KEY=eyJhbGciOiJI...anon-example

# Supabase service role key (server-side only, must remain secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...service-role-example

# Supabase JWT secret used to verify access tokens on the backend
# You can obtain this in the Supabase dashboard under Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=replace_with_your_supabase_jwt_secret

# (Optional) If your Supabase JWT issuer or audience differs, set here
# SUPABASE_JWT_ISSUER=https://your-issuer.example.com
# SUPABASE_JWT_AUDIENCE=authenticated

# Google/Vertex AI Gemini API key (server-side secret)
GEMINI_API_KEY=ya29.your_gemini_api_key_here

# Gemini model to use (optional override)
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated CORS origins allowed (frontend hosts)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Optional: set environment (development, production)
ENVIRONMENT=production
