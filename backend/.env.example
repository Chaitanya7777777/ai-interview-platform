# Backend environment variables — TEMPLATE
# =========================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# In production (Render), set these via the Render dashboard Environment tab.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres — get from Supabase dashboard → Settings → Database → URI
# Use the "Transaction pooler" connection string for Render (port 6543)
# MUST start with: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase auth ─────────────────────────────────────────────────────────────
# Supabase project URL — e.g. https://abcdefghij.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT secret — Supabase dashboard → Settings → API → JWT Secret
# REQUIRED in production. The backend uses this to verify user tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# JWT audience (do not change unless you customised Supabase auth)
SUPABASE_JWT_AUDIENCE=authenticated

# ── AI provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=groq

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model — llama-3.3-70b-versatile is the default
GROQ_MODEL=llama-3.3-70b-versatile

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL + keep localhost for local dev.
# Example: CORS_ORIGINS=https://my-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" on Render, "development" locally
ENVIRONMENT=development

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Service role key — NEVER add this to frontend/.env or Vercel env vars.
# Backend + Render only. Allows server-to-server uploads to private buckets.
# Find: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket name (create manually in Supabase Dashboard → Storage → New Bucket)
# Name: resumes, uncheck "Public bucket"
# Reserved for future: voice, reports
SUPABASE_STORAGE_BUCKET=resumes
